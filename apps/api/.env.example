# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 gitignore，不会进仓库。

# ---------- 本服务（前缀 CODE_AGENT_，由 app/settings.py 读取）----------

# 监听地址与端口
CODE_AGENT_HOST=0.0.0.0
CODE_AGENT_PORT=8000

# true 时开启 FastAPI debug 与 uvicorn 热重载；生产设 false
CODE_AGENT_DEBUG=true

# 允许跨域的前端来源，逗号分隔。生产走同源反代可留空
CODE_AGENT_CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# ---------- LangChain / LangGraph（不用前缀，由 SDK 自己读取）----------

# 模型密钥
ANTHROPIC_API_KEY=

# 追踪：设 true 后每次运行上报到 LangSmith，调试图流转时很有用
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=code-agent-dev

# ---------- 本地依赖服务（docker-compose.yml 读取）----------
# 改这里等于同时改容器和连接串，两边不会漂移。

# PostgreSQL：LangGraph 的 checkpointer 落库用
POSTGRES_USER=code_agent
POSTGRES_PASSWORD=change-me-in-local
POSTGRES_DB=code_agent
# 宿主机端口用 5433，避开其他项目的 5432
POSTGRES_PORT=5433

# Redis：会话状态与缓存
REDIS_PASSWORD=change-me-in-local
# 宿主机端口用 6380，避开其他项目的 6379
REDIS_PORT=6380

# ---------- 本服务连接串（前缀 CODE_AGENT_，由 app/settings.py 读取）----------
# 值里的 ${...} 由 docker compose 插值；直接 uv run 启动时请自行填实际值。

# 注意 host 是 localhost + 上面的宿主机端口。
# 服务若也跑在 compose 网络里，应改用 postgres:5432 / redis:6379。
CODE_AGENT_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
CODE_AGENT_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0

# ---------- 鉴权（前缀 CODE_AGENT_，由 app/settings.py 读取）----------

# JWT 签名密钥，必填，缺失即启动失败。
# 本地随便填；生产必须换成随机长串并从 k8s secret 注入。
# 生成：openssl rand -hex 32
# 注意：这个值泄漏等于任何人都能伪造任意用户，别提交真实值到仓库。
CODE_AGENT_JWT_SECRET=dev-only-not-a-real-secret

# 令牌有效期（天）
CODE_AGENT_JWT_EXPIRE_DAYS=7

# ---------- 短信验证码（前缀 CODE_AGENT_，由 app/settings.py 读取）----------

# 验证码有效期（秒）
CODE_AGENT_SMS_CODE_TTL_SECONDS=300

# 同一手机号两次发送的最小间隔（秒），挡连点与短信轰炸
CODE_AGENT_SMS_RESEND_COOLDOWN_SECONDS=60

# 同一验证码允许的连续校验失败次数，超过即作废该码
CODE_AGENT_SMS_MAX_ATTEMPTS=5
